SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy JWT (Legacy tab) or new sb_secret_… key (Secret keys) — both work after the API fix
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key
RESEND_API_KEY=re_xxx
INVITE_FROM_EMAIL="Owlry <hello@yourdomain.com>"

# Random long string — protects POST /api/invite-generate (optional; omit to disable generator)
ADMIN_INVITE_SECRET=

# ─── Phase 2 (sessions) ───────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
SESSION_COOKIE_SECRET=

# ─── Phase 4 (Stripe) — fill in when ready ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_FOUNDING_PRICE_ID=price_xxx
# Display-only placeholder; the source of truth is the Stripe price object.
FOUNDING_PRICE_USD=99

# ─── Phase 6 (Cloudflare Turnstile) — fill in when ready ─────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Phase 7 (admin dashboard) ───────────────────────────────────────────────
# Comma-separated list of emails allowed to access /admin
ADMIN_ALLOWED_EMAILS=
